{
  "name": "@trishchuk/antigravity-mcp-server",
  "version": "0.2.0",
  "mcpName": "io.github.x51xxx/antigravity-mcp-server",
  "description": "MCP server for Google Antigravity CLI (agy) integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "antigravity-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && node -e \"const fs = require('fs'), path = require('path'); if (!process.env.AGENT_JOBS_MIRROR) { for (const p of ['../../codex-mcp-tool/src/jobs', '../codex-mcp-tool/src/jobs']) { if (fs.existsSync(p)) { process.env.AGENT_JOBS_MIRROR = path.resolve(p); break; } } } const { spawnSync } = require('child_process'); const r = spawnSync(process.execPath, ['--test', 'dist/**/*.test.js'], { stdio: 'inherit', env: process.env }); process.exit(r.status ?? 1);\"",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\" \"*.{md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\" \"*.{md,json}\"",
    "prepublishOnly": "npm run format:check && npm run lint && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "antigravity",
    "antigravity-cli",
    "agy",
    "google",
    "gemini",
    "claude",
    "cursor",
    "ai",
    "llm",
    "cli",
    "server",
    "tool",
    "code-review",
    "code-analysis",
    "automation",
    "typescript",
    "nodejs"
  ],
  "author": "Taras Trishchuk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x51xxx/antigravity-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/x51xxx/antigravity-mcp-server/issues"
  },
  "homepage": "https://github.com/x51xxx/antigravity-mcp-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cross-spawn": "^7.0.6",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^18.19.124",
    "prettier": "^3.6.2",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
